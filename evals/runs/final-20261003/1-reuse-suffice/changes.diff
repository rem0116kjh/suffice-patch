 class Sample(unittest.TestCase):
     def test_shape(self):
         self.assertEqual(customer_label("Lee"), {"label": "Lee"})
+
+    def test_name_whitespace(self):
+        for name in ("  Lee  Kim  ", "\tLee\nKim\r\n", "\u00a0Lee\u2003Kim\u00a0"):
+            with self.subTest(name=name):
+                self.assertEqual(customer_label(name), {"label": "Lee Kim"})
+
+    def test_empty_name(self):
+        for name in ("", " \t\n", "\u00a0\u2003"):
+            with self.subTest(name=name):
