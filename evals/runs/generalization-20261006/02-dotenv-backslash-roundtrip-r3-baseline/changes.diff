+import io
+
+import pytest
+
+from dotenv import dotenv_values, get_key, set_key
+from dotenv.parser import Binding, Original, parse_stream
+
+
+@pytest.mark.parametrize("quote_mode", ["always", "auto"])
+@pytest.mark.parametrize("export", [False, True])
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "\\",
+        "\\" * 2,
+        "\\" * 3,
+        r"C:\new\test\\folder",
+        "trailing" + "\\" * 4,
+        "'\"''",
+        "\\'",
+        "\\\\'\"\\'",
+        "first\\\nsecond '\"\nlast\\",
+        "한글\\path\\",
+    ],
+)
+def test_quoted_set_key_roundtrip(tmp_path, quote_mode, export, value):
+    path = tmp_path / ".env"
+    before = "# keep this comment\nBEFORE='unchanged'\n"
+    after = 'AFTER="also unchanged" # keep this too\n'
+    path.write_text(before + "VALUE=old\n" + after, encoding="utf-8")
+
+    assert set_key(path, "VALUE", value, quote_mode, export) == (
+        True, "VALUE", value
+    )
+    assert get_key(path, "VALUE") == value
+    assert dotenv_values(path) == {
+        "BEFORE": "unchanged", "VALUE": value, "AFTER": "also unchanged"
+    }
+    contents = path.read_text(encoding="utf-8")
+    assert contents.startswith(before + ("export " if export else "") + "VALUE='")
+    assert contents.endswith(after)
+    set_key(path, "VALUE", value, quote_mode, export)
+    assert path.read_text(encoding="utf-8") == contents
+
+
+@pytest.mark.parametrize("quote", ["'", '"'])
+@pytest.mark.parametrize("count", [1, 2, 3, 4])
+@pytest.mark.parametrize("prefix", ["path", "first\nsecond"])
+def test_escaped_backslash_keeps_assignments_separate(quote, count, prefix):
+    first = "A=" + quote + prefix + "\\" * (2 * count) + quote + " # comment\n"
+    second = "B=" + quote + "next" + quote + "\n"
+    assert list(parse_stream(io.StringIO(first + second))) == [
+        Binding("A", prefix + "\\" * count, Original(first, 1), False),
+        Binding("B", "next", Original(second, first.count("\n") + 1), False),
+    ]
+
+
+@pytest.mark.parametrize("quote", ["'", '"'])
+def test_unknown_escapes_and_backslash_before_newline(quote):
+    value = "unknown\\q\\\nnext"
+    text = "A=" + quote + value + quote + "\nB=next\n"
+    assert dotenv_values(stream=io.StringIO(text)) == {"A": value, "B": "next"}
