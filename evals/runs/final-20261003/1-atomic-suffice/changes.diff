 import json
+import os
+import tempfile
 
 def save_settings(path, data):
-    with open(path, "w", encoding="utf-8") as f:
-        json.dump(data, f, ensure_ascii=False)
+    path = os.path.abspath(path)
+    temporary_path = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w", encoding="utf-8", dir=os.path.dirname(path), delete=False
+        ) as f:
+            temporary_path = f.name
+            json.dump(data, f, ensure_ascii=False)
+        os.replace(temporary_path, path)
+    finally:
+        if temporary_path is not None and os.path.exists(temporary_path):
+            os.unlink(temporary_path)
--- a/test_settings.py
+++ b/test_settings.py
@@ -0,0 +1,50 @@
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from settings import save_settings
+
+
+class SaveSettingsTests(unittest.TestCase):
+    def test_utf8_json_for_new_and_existing_files(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "settings.json"
+            for data in ({"name": "한글"}, {"name": "café", "values": [1, True, None]}):
+                with self.subTest(data=data):
+                    self.assertIsNone(save_settings(path, data))
+                    text = path.read_bytes().decode("utf-8")
+                    self.assertEqual(json.loads(text), data)
+                    self.assertIn(data["name"], text)
+                    self.assertEqual(list(Path(directory).iterdir()), [path])
+
+    def test_failures_preserve_destination_and_clean_up(self):
+        for exists in (False, True):
+            for failure in ("serialization", "replacement"):
+                with self.subTest(exists=exists, failure=failure):
+                    with tempfile.TemporaryDirectory() as directory:
+                        path = Path(directory) / "settings.json"
+                        original = b'{"original": true}\n'
+                        if exists:
+                            path.write_bytes(original)
+                        if failure == "serialization":
+                            with self.assertRaises(TypeError):
+                                save_settings(path, {"partial": [1, object()]})
+                        else:
+                            error = OSError("replacement failed")
+                            with patch("settings.os.replace", side_effect=error):
+                                with self.assertRaises(OSError) as raised:
+                                    save_settings(path, {"valid": True})
+                            self.assertIs(raised.exception, error)
+                        if exists:
+                            self.assertEqual(path.read_bytes(), original)
+                        else:
+                            self.assertFalse(path.exists())
+                        self.assertEqual(
+                            list(Path(directory).iterdir()), [path] if exists else []
+                        )
+
+
+if __name__ == "__main__":
+    unittest.main()
