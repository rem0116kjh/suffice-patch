+import pytest
+
+from packaging.specifiers import Specifier, SpecifierSet
+
+
+@pytest.mark.parametrize("specifier_type", [Specifier, SpecifierSet])
+@pytest.mark.parametrize("operator", ["==", "!="])
+@pytest.mark.parametrize(
+    "prefix, version, matches",
+    [
+        ("7!3.4.0.0", "7!3.4", True),
+        ("7!3.4.0.0", "7!3.4.0.0.5", True),
+        ("7!3.4.0.0", "7!3.4.0.1", False),
+        ("7!3.4.0.0", "8!3.4", False),
+        ("7!3.4.0.0", "3.4", False),
+        ("3.4.0.0", "7!3.4", False),
+        ("3.4.0.0", "3.4", True),
+        ("0!3.4.0.0", "3.4", True),
+        ("3.4.0.0", "0!3.4", True),
+        ("07!03.04.0.0", "7!3.4", True),
+    ],
+)
+def test_epoch_prefix(specifier_type, operator, prefix, version, matches):
+    expected = matches if operator == "==" else not matches
+    assert specifier_type(operator + prefix + ".*").contains(version) is expected
+
+
+@pytest.mark.parametrize("specifier_type", [Specifier, SpecifierSet])
+@pytest.mark.parametrize("suffix", ["a1", "rc1", ".dev1", ".post1", "+local.1"])
+def test_epoch_prefix_suffixes(specifier_type, suffix):
+    version = "7!3" + suffix
+    assert specifier_type("==7!3.0.0.*").contains(version, prereleases=True)
+    assert not specifier_type("!=7!3.0.0.*").contains(version, prereleases=True)
+
+
+@pytest.mark.parametrize("specifier_type", [Specifier, SpecifierSet])
+@pytest.mark.parametrize(
+    "version, matches",
+    [("7!3.4", True), ("7!3.4.0.1", True), ("7!3.4.1", False),
+     ("8!3.4", False), ("7!3.3", False)],
+)
+def test_epoch_compatible_release(specifier_type, version, matches):
+    assert specifier_type("~=7!3.4.0.0").contains(version) is matches
