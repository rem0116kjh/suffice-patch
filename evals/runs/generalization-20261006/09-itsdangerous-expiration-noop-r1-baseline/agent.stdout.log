e notation whitespace, invalid\n    E203\n    # line length, handled by bugbear B950\n    E501\n    # bare except, handled by bugbear B001\n    E722\n    # bin op line break, invalid\n    W503\n# up to 88 allowed by bugbear B950\nmax-line-length = 80\nper-file-ignores =\n    # __init__ exports names\n    src/itsdangerous/__init__.py: F401\n\n[mypy]\nfiles = src/itsdangerous\npython_version = 3.7\nshow_error_codes = True\ndisallow_subclassing_any = True\ndisallow_untyped_calls = True\ndisallow_untyped_defs = True\ndisallow_incomplete_defs = True\nno_implicit_optional = True\nlocal_partial_types = True\nno_implicit_reexport = True\nstrict_equality = True\nwarn_redundant_casts = True\nwarn_unused_configs = True\nwarn_unused_ignores = True\nwarn_return_any = True\nwarn_unreachable = True\n\n[mypy-itsdangerous.jws]\ndisallow_untyped_defs = False\ntests/test_itsdangerous/test_timed.py:11:from itsdangerous.exc import SignatureExpired\ntests/test_itsdangerous/test_timed.py:21:    def ts(self):\ntests/test_itsdangerous/test_timed.py:35:    def test_max_age(self, signer, ts, freeze):\ntests/test_itsdangerous/test_timed.py:38:        assert signer.unsign(signed, max_age=10) == b\"value\"\ntests/test_itsdangerous/test_timed.py:41:        with pytest.raises(SignatureExpired) as exc_info:\ntests/test_itsdangerous/test_timed.py:42:            signer.unsign(signed, max_age=10)\ntests/test_itsdangerous/test_timed.py:46:    def test_return_timestamp(self, signer, ts):\ntests/test_itsdangerous/test_timed.py:48:        assert signer.unsign(signed, return_timestamp=True) == (b\"value\", ts)\ntests/test_itsdangerous/test_timed.py:50:    def test_timestamp_missing(self, signer):\ntests/test_itsdangerous/test_timed.py:60:    def test_malformed_timestamp(self, signer):\ntests/test_itsdangerous/test_timed.py:73:    def test_malformed_future_timestamp(self, signer):\ntests/test_itsdangerous/test_timed.py:86:            with pytest.raises(SignatureExpired) as exc_info:\ntests/test_itsdangerous