      "/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport copy\nimport unittest\nimport notes\n\nclass UpdateNoteTests(unittest.TestCase):\n    def setUp(self):\n        self.original = copy.deepcopy(notes.NOTES)\n\n    def tearDown(self):\n        notes.NOTES.clear()\n        notes.NOTES.update(self.original)\n\n    def test_owner_update_and_detached_result(self):\n        for user_id, note_id, text in [(7, 1, 'updated'), (8, 2, '')]:\n            with self.subTest(note_id=note_id):\n                result = notes.update_note(user_id, note_id, text)\n                self.assertEqual(result, {'owner': user_id, 'text': text})\n                self.assertEqual(notes.read_note(user_id, note_id), result)\n                self.assertIsNot(result, notes.NOTES[note_id])\n                result['text'] = 'changed copy'\n                self.assertEqual(notes.NOTES[note_id]['text'], text)\n\n    def test_rejections_match_read_and_preserve_all_notes(self):\n        for user_id, note_id in [(None, 1), (None, 999), (8, 1), (7, 2), (7, 999)]:\n            with self.subTest(user_id=user_id, note_id=note_id):\n                before = copy.deepcopy(notes.NOTES)\n                try:\n                    notes.read_note(user_id, note_id)\n                except (PermissionError, KeyError) as error:\n                    expected_type, expected_args = type(error), error.args\n                else:\n                    self.fail('Expected read rejection')\n                with self.assertRaises(expected_type) as rejected:\n                    notes.update_note(user_id, note_id, 'must not persist')\n                self.assertEqual(rejected.exception.args, expected_args)\n                self.assertEqual(notes.NOTES, before)\n\nunittest.main()\nPY\n git diff --check; git diff -- notes.py\""
    ],
