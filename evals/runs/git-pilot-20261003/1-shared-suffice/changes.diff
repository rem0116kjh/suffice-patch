--- a/test_sample.py
+++ b/test_sample.py
@@ -1,6 +1,25 @@
 import unittest
+import api
+import export
+import web
 from paging import page_size
 
 class Sample(unittest.TestCase):
     def test_valid(self):
         self.assertEqual(page_size("5"), 5)
+
+    def test_normalization(self):
+        cases = [(None, 20), ("", 20), (" ", 20), ("bad", 20),
+                 ("1.5", 20), (0, 20), ("0", 20), (-1, 20),
+                 ("-5", 20), (101, 100), ("1000", 100)]
+        for size in range(1, 101):
+            cases.extend([(size, size), (str(size), size)])
+        callers = (page_size, web.limit, export.limit,
+                   lambda value: api.limit({"limit": value}))
+        for caller in callers:
+            for raw, expected in cases:
+                with self.subTest(caller=caller, raw=raw):
+                    self.assertEqual(caller(raw), expected)
+
+    def test_missing_api_limit(self):
+        self.assertEqual(api.limit({}), 20)
