+import unittest
+from unittest.mock import call, patch
+
+import catalog
+import prices
+from routes import price
+
+
+class PriceCacheTests(unittest.TestCase):
+    def test_cache_is_per_product_and_currency(self):
+        combinations = [
+            ("book", "USD", 12),
+            ("book", "EUR", 11),
+            ("pen", "USD", 0),
+            ("pen", "EUR", 2),
+        ]
+        with patch.object(prices, "CACHE", {}), patch.object(
+            catalog, "fetch", wraps=catalog.fetch
+        ) as fetch:
+            for requests in (combinations, list(reversed(combinations))):
+                for product, currency, amount in requests:
+                    with self.subTest(product=product, currency=currency):
+                        self.assertEqual(
+                            price({"product": product, "currency": currency}),
+                            {"amount": amount},
+                        )
+            self.assertEqual(
+                fetch.call_args_list,
+                [call(product, currency) for product, currency, _ in combinations],
+            )
