@@ -0,0 +1,67 @@
+import io
+
+import pytest
+
+from dotenv import dotenv_values, get_key, set_key
+from dotenv.parser import Binding, Original, parse_stream
+
+
+@pytest.mark.parametrize("quote_mode", ["always", "auto"])
+@pytest.mark.parametrize("export", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "value",
+    [
+        "\\",
+        "\\" * 4,
+        "path\\\\part\\",
+        "\\'\"'\\\\'",
+        "first\\\nsecond 'quoted'\nlast\\",
+        r"literal\n\t\q and \\ repeated",
+        "한글\\'café\\",
+    ],
+)
+def test_quoted_set_key_roundtrip(tmp_path, quote_mode, export, existing, value):
+    path = tmp_path / ".env"
+    prefix = "# keep this comment\nBEFORE='unchanged'\n"
+    suffix = "AFTER=\"unchanged\" # keep spacing\n"
+    path.write_text(prefix + ("VALUE=old\n" if existing else "") + suffix)
+
+    assert set_key(path, "VALUE", value, quote_mode, export) == (True, "VALUE", value)
+    assert get_key(path, "VALUE") == value
+    assert dotenv_values(path) == {
+        "BEFORE": "unchanged",
+        "VALUE": value,
+        "AFTER": "unchanged",
+    }
+    content = path.read_text()
+    assert content.startswith(prefix)
+    assert suffix in content
+    assert ("export VALUE=" in content) == export
+
+    # A second rewrite must recognize the entire previously written value.
+    set_key(path, "VALUE", value, quote_mode, export)
+    assert path.read_text() == content
+
+
+@pytest.mark.parametrize("quote", ["'", '"'])
+@pytest.mark.parametrize("count", [1, 2, 3, 4])
+@pytest.mark.parametrize("prefix", ["text", "first\\\nsecond", r"unknown\q"])
+def test_escaped_backslash_keeps_next_assignment_separate(quote, count, prefix):
+    first = "A=" + quote + prefix + "\\" * (2 * count) + quote + " # comment\n"
+    second = "B=" + quote + "next" + quote + "\n"
+    assert list(parse_stream(io.StringIO(first + second))) == [
+        Binding("A", prefix + "\\" * count, Original(first, 1), False),
+        Binding("B", "next", Original(second, first.count("\n") + 1), False),
+    ]
+
+
+@pytest.mark.parametrize("quote", ["'", '"'])
+@pytest.mark.parametrize("count", [1, 2, 3, 4])
+def test_escaped_quote_after_backslashes(quote, count):
+    encoded = "\\" * (2 * count + 1) + quote
+    source = "A=" + quote + encoded + quote + "\nB=next\n"
+    assert dotenv_values(stream=io.StringIO(source)) == {
+        "A": "\\" * count + quote,
+        "B": "next",
+    }
