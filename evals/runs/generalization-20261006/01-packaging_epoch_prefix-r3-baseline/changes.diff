+# This file is dual licensed under the terms of the Apache License, Version
+# 2.0, and the BSD License. See the LICENSE file in the root of this repository
+# for complete details.
+
+import pytest
+
+from packaging.specifiers import Specifier, SpecifierSet
+from packaging.version import Version
+
+
+@pytest.mark.parametrize("specifier_type", [Specifier, SpecifierSet])
+@pytest.mark.parametrize("version_type", [str, Version])
+@pytest.mark.parametrize(
+    "prefix, version, expected",
+    [
+        ("7!3.4.0.0.*", "7!3.4", True),
+        ("7!3.4.0.0.*", "7!3.4.0.0.1", True),
+        ("7!3.4.0.0.*", "7!3.4.1", False),
+        ("7!3.4.0.0.*", "8!3.4", False),
+        ("7!3.4.0.0.*", "3.4", False),
+        ("3.4.0.0.*", "7!3.4", False),
+        ("3.4.0.0.*", "3.4", True),
+        ("0!3.4.0.0.*", "3.4", True),
+        ("3.4.0.0.*", "0!3.4", True),
+        ("07!03.04.0.0.*", "7!3.4", True),
+        ("7!3.0.0.*", "7!3a1", True),
+        ("7!3.*", "7!3rc1", True),
+    ],
+)
+def test_epoch_prefix(specifier_type, version_type, prefix, version, expected):
+    candidate = version_type(version)
+    assert specifier_type("==" + prefix).contains(candidate, prereleases=True) is expected
+    assert (
+        specifier_type("!=" + prefix).contains(candidate, prereleases=True) is not expected
+    )
+
+
+@pytest.mark.parametrize(
+    "suffix", ["a1", "b1", "rc1", ".dev1", ".post1", "rc1.post1.dev1", "+local.1"]
+)
+def test_epoch_prefix_suffixes(suffix):
+    candidate = "7!3.4" + suffix
+    assert Specifier("==7!3.4.0.0.*").contains(candidate, prereleases=True)
+    assert not Specifier("!=7!3.4.0.0.*").contains(candidate, prereleases=True)
+    assert not Specifier("==8!3.4.0.0.*").contains(candidate, prereleases=True)
+
+
+@pytest.mark.parametrize("specifier_type", [Specifier, SpecifierSet])
+@pytest.mark.parametrize(
+    "version, expected",
+    [("7!3.4", True), ("7!3.4.0.1", True), ("7!3.4.1", False), ("8!3.4", False)],
+)
+def test_epoch_compatible_release(specifier_type, version, expected):
+    assert specifier_type("~=7!3.4.0.0").contains(version) is expected
+
+
+def test_epoch_prefix_set_filter():
+    spec = SpecifierSet("==7!3.4.0.0.*,!=7!3.4.0.0.1.*")
+    assert list(spec.filter(["7!3.4", "7!3.4.0.0.1", "8!3.4"])) == ["7!3.4"]
